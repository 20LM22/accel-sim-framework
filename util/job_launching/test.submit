#! /bin/bash
#SBATCH -J REPLACE_NAME
#SBATCH --threads-per-core=1
#SBATCH --cpus-per-task=1
#SBATCH --nodes=1
#SBATCH --mem-per-cpu=32G
#SBATCH --time=01:00:00
#SBATCH --mail-type=END,FAIL
#SBATCH --export=ALL
#SBATCH --output=REPLACE_SUBDIR/%x.o%j
#SBATCH --error=REPLACE_SUBDIR/%x.e%j
#SBATCH --chdir=REPLACE_SUBDIR

apptainer exec /scratch/gpfs/WENTZLAF/lm4677/accel-sim-framework_ubuntu-24.04-cuda-12.8.sif \
    bash -c "
        source /scratch/gpfs/WENTZLAF/lm4677/venv/bin/activate && \
        bash REPLACE_SUBDIR/slurm.sim && \
        python3 /scratch/gpfs/WENTZLAF/lm4677/analytical-model/util/job_launching/log_output.py REPLACE_SUBDIR export_dict_REPLACE_NAME.json REPLACE_NAME ${SLURM_JOB_ID} && \
        mkdir -p REPLACE_SUBDIR/stats && \
        python3 /scratch/gpfs/WENTZLAF/lm4677/analytical-model/util/job_launching/get_stats.py -l REPLACE_SUBDIR/logfiles/sim_log.REPLACE_LAUNCH_NAME.REPLACE_NAME.${SLURM_JOB_ID}.txt | tee REPLACE_SUBDIR/stats/stats.REPLACE_LAUNCH_NAME.REPLACE_NAME.${SLURM_JOB_ID}.csv
    "
